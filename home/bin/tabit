#!/bin/bash

readonly RC=${1:-0}  # This is passed from the PS1 prompt.
readonly CD="$(pwd)"

LOCATION="(none)"
PJTYPE=""

# Some colors
if [[ -n "${TABIT_PS1:-}" ]]; then
    # For inclusion in PS1 via PROMPT_COMMAND; Bash decodes \[ \] in pass 1.
    blue='\[\033[38;5;33m\]'
    yellow='\[\033[1;33m\]'
    purple='\[\033[1;33;44m\]'
    reset='\[\033[0m\]'
else
    blue=$'\033[38;5;33m'
    yellow=$'\033[1;33m'
    purple=$'\033[1;33;44m'
    reset=$'\033[0m'
fi

escape_ps1() {
    local s="$1"
    if [[ -n "${TABIT_PS1:-}" ]]; then
        s="${s//\\/\\\\\\\\}"
        s="${s//\$/\\\\\\044}"
        s="${s//\`/\\\\\\140}"
    fi
    printf '%s' "$s"
}

[[ "${CD}" =~ .*/Projects/([^/]*)/?.* ]] && LOCATION="${BASH_REMATCH[1]}" && PJTYPE=" dir "
[[ "${CD}" =~ .*/Projects/Coding/([^/]*)/.* ]] && LOCATION="${BASH_REMATCH[1]}"

# Check git branch, if any
gitbranch=$(git branch 2>/dev/null | grep '\*' | awk '{print $2}')
if [[ -n "${gitbranch}" ]]; then
    root="$(git rev-parse --show-toplevel 2>/dev/null)"
    LOCATION="@${gitbranch}"
    [[ "${root}" != "${CD}" ]] && LOCATION="${root##*/}${LOCATION}"
    PJTYPE=" git "
    url="$(git config --get remote.origin.url 2>/dev/null)"
    if [[ ${url} =~ https://github.com/([^/]*)/.*(.git)? ]]; then
        PJTYPE="[github] ${BASH_REMATCH[1]}"
    fi

fi

# Check if projectile project
rootdir="${CD}"
while [[ "${rootdir}" != "/" ]]; do
    [[ -f "${rootdir}/.projectile" ]] && break
    rootdir="$(dirname "${rootdir}")"
done
if [[ "${rootdir}" != "/" ]]; then
    LOCATION=""
    [[ "${rootdir}" != "${CD}" ]] && LOCATION="$(basename "${rootdir}")"
    PJTYPE=" pjtile "
fi

# Check for temp locations
if [[ "${CD}" =~ /tmp/?.* ]] || [[ "${CD}" =~ ${HOME}/TEMP/?.* ]]; then
    PJTYPE=" tmp "
    LOCATION=$(du -ksh "${CD}" 2>/dev/null | awk '{print $1}')
fi

HOSTNAME=""  # only for remote locations
[[ -n "${SSH_TTY:-}" || -n "${SSH_CONNECTION:-}" ]] && HOSTNAME="$(hostname)"

TABNAME="${PJTYPE}${PJTYPE:+/}${LOCATION}"

PROMPT=""
if [[ -n "${HOSTNAME}" ]]; then
    PROMPT+="${purple}$(escape_ps1 "${HOSTNAME}")${reset}"
fi
if [[ -n "${PJTYPE}" ]]; then
    PROMPT+="${PROMPT:+ }${blue}$(escape_ps1 "${PJTYPE}")${reset}"
fi
if [[ -n "${LOCATION}" ]]; then
    PROMPT+="${PROMPT:+ }${yellow}$(escape_ps1 "${LOCATION}")${reset}"
fi

# Print the prompt
printf '%s' "${PROMPT}"

# update the tab if it is running in Konsole
if [[ -n "${KONSOLE_DBUS_SESSION:-}" && -n "${KONSOLE_DBUS_SERVICE:-}" ]]; then
    dbus-send --type=method_call --session \
              --dest="${KONSOLE_DBUS_SERVICE}" \
              "${KONSOLE_DBUS_SESSION}" \
              org.kde.konsole.Session.setTitle int32:1 string:"${TABNAME}" >/dev/null 2>&1
fi

# make sure this script return the passed-in return code so the PS1 can use the commands's $
exit ${RC}
